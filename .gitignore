cat << 'EOF' > .gitignore
# Virtual Environment
.venv/
venv/
ENV/
env/

# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# VS Code workspace settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Environment variables & secrets
.env

# OS generated files
.DS_Store
Thumbs.db
EOF
